<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="FinTech Enterprise Master Test Suite" parallel="classes" thread-count="2">
    <listeners>
        <listener class-name="com.fintech.automation.listeners.TestListener"/>
    </listeners>

    <test name="FinTech Multi-Tier Test Suite">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.fintech.automation.tests.SmokeTestSuite"/>
            <class name="com.fintech.automation.tests.ClientProfileTest"/>
            <class name="com.fintech.automation.tests.FundTransferE2ETest"/>
            <class name="com.fintech.automation.tests.CentralBankIntegrationTest"/>
        </classes>
    </test>
</suite>
