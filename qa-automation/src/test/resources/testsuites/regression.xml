<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="FinTech Cross-Browser Regression Suite" parallel="tests" thread-count="3">
    <listeners>
        <listener class-name="com.fintech.automation.listeners.TestListener"/>
    </listeners>

    <test name="Chrome Regression Execution">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.fintech.automation.tests.ClientProfileTest"/>
            <class name="com.fintech.automation.tests.FundTransferE2ETest"/>
        </classes>
    </test>

    <test name="Firefox Regression Execution">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.fintech.automation.tests.ClientProfileTest"/>
            <class name="com.fintech.automation.tests.FundTransferE2ETest"/>
        </classes>
    </test>

    <test name="Edge Regression Execution">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.fintech.automation.tests.ClientProfileTest"/>
            <class name="com.fintech.automation.tests.FundTransferE2ETest"/>
        </classes>
    </test>
</suite>
