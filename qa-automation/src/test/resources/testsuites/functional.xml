<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="FinTech Functional Automation Suite" parallel="classes" thread-count="2">
    <listeners>
        <listener class-name="com.fintech.automation.listeners.TestListener"/>
    </listeners>

    <test name="FinTech Functional Tests">
        <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="functional"/>
            </run>
        </groups>
        <classes>
            <class name="com.fintech.automation.tests.ClientProfileTest"/>
            <class name="com.fintech.automation.tests.FundTransferE2ETest"/>
            <class name="com.fintech.automation.tests.CentralBankIntegrationTest"/>
        </classes>
    </test>
</suite>
